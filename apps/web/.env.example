# Firebase project (optional — the app runs in local demo mode without it).
# Create a project at https://console.firebase.google.com, enable Auth
# (Google provider) + Firestore, then copy the web app config here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
