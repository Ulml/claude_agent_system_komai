# --- LLM binding (the harness is provider-agnostic) ---
LLM_PROVIDER=google            # google | openai | anthropic | ollama
LLM_MODEL=gemini-2.5-flash

# Provider keys (set only the one you use; NEVER commit real keys)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- LangSmith tracing (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=template-lm
